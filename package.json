{
  "name": "pied-piper",
  "version": "0.1.0",
  "description": "Multi-role coding agent collaboration runtime with GitHub as the source of truth",
  "type": "module",
  "bin": {
    "piedpiper": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}
